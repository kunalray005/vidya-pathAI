# Frontend (Vite) - safe to expose, restricted by Firestore rules and App Check
VITE_FIREBASE_API_KEY=PASTE_YOUR_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=vidyapath-ai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vidyapath-ai
VITE_FIREBASE_STORAGE_BUCKET=vidyapath-ai.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=975796761520
VITE_FIREBASE_APP_ID=1:975796761520:web:8ecc2722bfae9df460dc75
# Set to true to point the app at the local Firebase Emulator Suite
VITE_USE_EMULATORS=false

# Seeding (server side only, never shipped to the browser)
# Path to a Firebase service account JSON. Leave empty when seeding the emulator.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=
DEMO_STUDENT_EMAIL=aarav@vidyapath.demo
DEMO_STUDENT_PASSWORD=
DEMO_ADMIN_EMAIL=admin@vidyapath.demo
DEMO_ADMIN_PASSWORD=
DEMO_PEER_PASSWORD=
